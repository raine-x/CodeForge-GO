# CodeForge 环境变量模板
#
# 用法：复制为 .env 后填写真实值。
#   cp .env.example .env
#
# 注意：.env 已被 .gitignore 忽略，切勿提交到版本库。
# 服务启动时会自动加载本目录下的 .env（不覆盖真实环境变量）；
# pytest 亦会读取本目录下的 .env。

# ---- LLM 接入（CodeForge 服务端）----
# 按当前 provider 选择其一即可；CODEFORGE_API_KEY 优先级最高
CODEFORGE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- LLM 接入（pytest 测试用）----
LLM_BASE_URL=https://api.tokenrouter.com/v1
LLM_MODEL=z-ai/glm-5.3-free
LLM_API_KEY=
LLM_TIMEOUT=120
