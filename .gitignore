# ============================================================== 构建产物
/bin/
*.exe
*.test
*.out

# 多平台发布产物（交叉编译的输出目录）
/dist/

# `go build ./cmd/agent` 在输出路径失效时的落点：Go 按**包名**命名，
# 于是产物变成根目录下一个没有扩展名的 `agent`（Windows 上也不叫 .exe，
# 所以上面的 *.exe 盖不住它）。
/agent

# ============================================================== 运行时数据
# 会话记录、审计日志、撤销快照 —— 由程序自动生成
.codeforge/
# 运行实例信息（含内部关闭令牌），供 codeforge stop / restart 使用
config/codeforge.run

# ============================================================== 密钥与本地配置
# 严禁提交任何包含 API Key 的内容。
# 密钥只从**系统环境变量**读，程序不读密钥文件（见 AGENTS.md 硬规则 10a）。
# 下列文件会自动生成（见 README「配置与密钥」一节）：
#   config/local.yaml     → 首次启动自动生成模板
#   config/models.yaml     → 界面「设置」保存模型库
#   config/providers.yaml  → 界面「设置」保存供应商

# --- 本地覆盖配置（可能含 API Key）
config/local.yaml
config/local.yml
config/*.local.yaml
config/*.local.yml
# --- 模型库（设置页统一管理；明文 Key 只存服务端）
config/models.yaml
# 模型库只应出现在 config/ 下。测试/异常退化成相对路径时会在别的目录生成同名文件
# （pkg/server/models.yaml 曾被误提交进仓库），这里一并忽略，防复发。
*models.yaml

# --- 供应商库（设置页统一管理；**同样含明文 Key**：key_value 字段）
# 与 models.yaml 是一对，漏掉它等于把密钥原样暴露给 git。
config/providers.yaml
*providers.yaml

# --- 按命名约定兜底的密钥文件
# ⚠️ 下面几条匹配的是**文件名**，不是内容。代价：名字里带 secret / credential
# 的**正常源码**也会被静默忽略 —— 写 config/credentials.go 时它没进版本库，
# `git status` 连提示都没有，只有 `git check-ignore` 查得到。
# 所以代码文件避开这些词：凭据解析那套叫 config/resolve_llm.go。
*apikey*
*api_key*
*api-key*
*secret*
*credential*
*credentials*
!.gitignore
!*.example
!*.example.*

# --- 密钥目录
secrets/
.secrets/
.credentials/

# ============================================================== 编辑器 / 系统
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ============================================================== Python（pytest）
.pytest_cache/
__pycache__/
*.py[cod]
.venv/
venv/

# ============================================================== 临时文件
*.tmp
*.log
# AGENTS.md 要求调试备份用 .bak，而备份件常含明文密钥（config/local.yaml.bak 就是），
# 不忽略等于留一个「看起来像临时文件、其实是密钥」的坑给下一次 git add。
*.bak

docs